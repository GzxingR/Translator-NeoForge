# Copy to your shell profile or set per-session. DO NOT commit real values.

# Modrinth publish (scripts/publish-modrinth.ps1)
# MODRINTH_TOKEN=mrp_xxxxxxxx

# GitHub push (scripts/push-github.ps1)
# GH_TOKEN=ghp_xxxxxxxx

# Optional: Tencent API integration test only
# TENCENT_SECRET_ID=AKIDxxxxxxxx
# TENCENT_SECRET_KEY=xxxxxxxx

# Optional: DeepSeek API (external automation, not used by mod runtime)
# DEEPSEEK_API_KEY=sk-xxxxxxxx
